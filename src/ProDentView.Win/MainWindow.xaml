<Window x:Class="ProDentView.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="ProDENT View"
        Width="1500"
        Height="880"
        MinWidth="1100"
        MinHeight="720"
        Background="#F5F6F8">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE2" BorderThickness="0,0,1,0">
      <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="ProDENT View" FontSize="22" FontWeight="SemiBold" />
          <TextBlock x:Name="CameraModeText"
                     Margin="0,6,0,14"
                     Foreground="#667085"
                     Text="UVC still capture workflow" />
          <TextBlock Text="Name" Foreground="#475467" />
          <TextBox x:Name="PatientNameBox"
                   Margin="0,3,0,8"
                   Height="28"
                   VerticalContentAlignment="Center" />
          <TextBlock Text="Chart ID" Foreground="#475467" />
          <TextBox x:Name="ChartNumberBox"
                   Margin="0,3,0,8"
                   Height="28"
                   VerticalContentAlignment="Center" />
          <TextBlock Text="Phone" Foreground="#475467" />
          <TextBox x:Name="PhoneBox"
                   Margin="0,3,0,8"
                   Height="28"
                   VerticalContentAlignment="Center" />
          <TextBlock Text="Email" Foreground="#475467" />
          <TextBox x:Name="EmailBox"
                   Margin="0,3,0,8"
                   Height="28"
                   VerticalContentAlignment="Center" />
          <TextBlock Text="Notes" Foreground="#475467" />
          <TextBox x:Name="NotesBox"
                   Margin="0,3,0,8"
                   MinHeight="48"
                   TextWrapping="Wrap"
                   AcceptsReturn="True" />
          <UniformGrid Columns="2">
            <Button x:Name="AddPatientButton"
                    Height="34"
                    Margin="0,0,4,0"
                    Content="New"
                    Click="AddPatientButton_Click" />
            <Button x:Name="SavePatientButton"
                    Height="34"
                    Margin="4,0,0,0"
                    Content="Save"
                    Click="SavePatientButton_Click" />
          </UniformGrid>
          <TextBox x:Name="SearchBox"
                   Margin="0,12,0,8"
                   Height="30"
                   VerticalContentAlignment="Center"
                   TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <ListBox x:Name="PatientList"
                 Margin="0,360,0,0"
                 DisplayMemberPath="Name"
                 SelectionChanged="PatientList_SelectionChanged" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="64" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#050505" CornerRadius="6" Padding="12">
        <Grid x:Name="PreviewFrame" SizeChanged="PreviewFrame_SizeChanged">
          <wfi:WindowsFormsHost x:Name="PreviewHost"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
            <wf:Panel x:Name="PreviewPanel" BackColor="Black" />
          </wfi:WindowsFormsHost>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PreviewStatusText"
                       Text="Camera preview will appear here"
                       Foreground="#C9CDD4"
                       FontSize="18"
                       TextAlignment="Center" />
            <TextBlock Text="Default preview: 1280 x 720 when available"
                       Margin="0,8,0,0"
                       Foreground="#8B929E"
                       TextAlignment="Center" />
            <TextBlock Text="Capture path: UVC still pin first, preview frame fallback"
                       Margin="0,4,0,0"
                       Foreground="#8B929E"
                       TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel Grid.Row="1" LastChildFill="False">
        <TextBlock x:Name="CameraStatusText"
                   VerticalAlignment="Center"
                   Foreground="#475467"
                   Text="No camera active" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ComboBox x:Name="CameraComboBox"
                    Width="260"
                    Margin="0,0,8,0"
                    DisplayMemberPath="Name"
                    SelectionChanged="CameraComboBox_SelectionChanged" />
          <Button x:Name="RefreshCameraButton"
                  Width="116"
                  Margin="0,0,8,0"
                  Content="Refresh"
                  Click="RefreshCameraButton_Click" />
          <Button x:Name="CaptureButton"
                  Width="128"
                  Content="Capture"
                  Click="CaptureButton_Click" />
        </StackPanel>
      </DockPanel>
    </Grid>

    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE2" BorderThickness="1,0,0,0">
      <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Images" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="SelectedPatientText"
                     Margin="0,4,0,12"
                     Foreground="#667085"
                     Text="Select a patient" />
          <WrapPanel>
            <Button Width="78" Content="Import" Click="ImportButton_Click" />
            <Button Width="78" Margin="8,0,0,0" Content="Export" Click="ExportButton_Click" />
            <Button Width="78" Margin="8,0,0,0" Content="Select All" Click="SelectAllButton_Click" />
            <Button Width="86" Margin="8,8,0,0" Content="Delete" Click="DeleteButton_Click" />
            <Button Width="106" Margin="8,8,0,0" Content="Diagnostics" Click="DiagnosticsButton_Click" />
          </WrapPanel>
        </StackPanel>

        <ListBox x:Name="ImageList"
                 Margin="0,102,0,0"
                 DisplayMemberPath="FileName"
                 SelectionMode="Extended"
                 MouseDoubleClick="ImageList_MouseDoubleClick" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
